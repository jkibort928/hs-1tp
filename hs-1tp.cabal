cabal-version:   3.0
name:            hs-1tp
version:         0.0.1.0
synopsis:        A simple single-file oneshot HTTPS server
license:         MIT
license-file:    LICENSE
author:          Jack Kibort
maintainer:      jkibort928@gmail.com
build-type:      Simple

common warnings
    ghc-options: -Wall

executable hs-1tp
    import:           warnings
    main-is:          Main.hs
    build-depends:    
          base
        , network
        , bytestring
        , directory
        , unix
        , time
        , crypton
        , memory
        
    hs-source-dirs:   src
    other-modules:
          Paths_hs_1tp
        , Version
        , CLIUtil
        , TCPServer
        , EphemHttps
    default-language: Haskell2010
